FROM python:3.11-slim AS toolchain

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        protobuf-compiler \
        protobuf-compiler-grpc \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
        grpcio==1.83.0 \
        grpcio-tools==1.83.0 \
        protobuf==7.35.1

COPY scripts/generate.sh /usr/local/bin/generate-contracts

ENTRYPOINT ["/usr/local/bin/generate-contracts"]

# The build graph includes every generator/source input; unchanged profiles reuse
# the generated layer. Export is separate from the reusable toolchain image.
FROM toolchain AS generated
WORKDIR /source
COPY proto proto
COPY sdk sdk
COPY scripts scripts
COPY LICENSE LICENSE
ARG CONTRACT_PROFILE=training
RUN generate-contracts "${CONTRACT_PROFILE}"

FROM scratch AS artifact
COPY --from=generated /output/ /
